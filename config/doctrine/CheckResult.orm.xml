<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\CheckResult" table="checks_results">
        <id name="id" type="bigint">
            <generator strategy="AUTO"/>
        </id>
        <field name="monitorId" type="integer" column="monitor_id"/>
        <field name="status" type="string" length="50"/>
        <field name="responseTimeMs" type="integer" column="response_time_ms"/>
        <field name="checkedAt" type="datetime_immutable" column="checked_at"/>
        <field name="errorMessage" type="text" column="error_message" nullable="true"/>
    </entity>

</doctrine-mapping>
