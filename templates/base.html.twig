<!DOCTYPE html>
<html class="h-full bg-slate-50 text-slate-800">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}SiteTrack - Solopreneur Ops Suite{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📡</text></svg>">
        
        {% block stylesheets %}{% include 'components/_stylesheets.html.twig' %}{% endblock %}

        {% block javascripts %}{% block importmap %}{% include 'components/_importmap.html.twig' %}{% endblock %}{% endblock %}
    </head>
    <body class="h-full flex flex-col font-sans antialiased">
        <header class="bg-white border-b border-slate-200 shrink-0">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex">
                        <div class="flex-shrink-0 flex items-center">
                            <span class="text-xl font-black text-indigo-600 tracking-tight flex items-center">
                                📡 SiteTrack
                            </span>
                        </div>
                        <nav class="ml-6 flex space-x-8">
                            <a href="{{ path('dashboard_index') }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') == 'dashboard_index' ? 'border-indigo-500 text-slate-900' : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700' }}">
                                Dashboard
                            </a>
                            <a href="{{ path('availability_index') }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') starts with 'availability' or app.request.attributes.get('_route') starts with 'monitor' or app.request.attributes.get('_route') == 'rule_new' ? 'border-indigo-500 text-slate-900' : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700' }}">
                                Disponibilité
                            </a>
                            <a href="{{ path('analytics_index') }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') starts with 'analytics' ? 'border-indigo-500 text-slate-900' : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700' }}">
                                Analytics
                            </a>
                        </nav>
                    </div>
                    {% if app.user %}
                        <div class="flex items-center">
                            <span class="text-sm text-slate-500 mr-4">{{ app.user.userIdentifier }}</span>
                            <a href="{{ path('app_logout') }}" class="text-sm font-medium text-slate-500 hover:text-slate-700">Log out</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto">
            <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
                {# Display Flash Messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 mx-4 sm:mx-0 p-4 rounded-md {{ label == 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </main>

        <footer class="bg-white border-t border-slate-200 py-4 shrink-0">
            <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-400">
                &copy; 2026 SiteTrack. Minimalist Operations Suite for Solopreneurs.
            </div>
        </footer>
    </body>
</html>
