<!DOCTYPE html>
<html class="bg-paper text-ink">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}SiteTrack - Suite d'opérations pour solopreneurs{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📡</text></svg>">

        {% block stylesheets %}{% include 'components/_stylesheets.html.twig' %}{% endblock %}

        {% block javascripts %}{% block importmap %}{% include 'components/_importmap.html.twig' %}{% endblock %}{% endblock %}
    </head>
    <body class="font-body antialiased">
        {% import 'components/_macros.html.twig' as m %}
        <header class="bg-white border-b border-line sticky top-0 z-20" data-controller="mobile-nav">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex">
                        <div class="flex-shrink-0 flex items-center">
                            {{ m.brand_mark() }}
                        </div>
                        {% if workspace is defined and workspace %}
                            <nav class="hidden sm:ml-6 sm:flex sm:space-x-8">
                                <a href="{{ path('workspace_dashboard_index', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') == 'workspace_dashboard_index' ? 'border-signal text-ink' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                                    Tableau de bord
                                </a>
                                <a href="{{ path('workspace_availability_index', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') starts with 'workspace_availability' or app.request.attributes.get('_route') starts with 'workspace_monitor' or app.request.attributes.get('_route') == 'workspace_rule_new' ? 'border-signal text-ink' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                                    Disponibilité
                                </a>
                                <a href="{{ path('workspace_analytics_index', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') starts with 'workspace_analytics' ? 'border-signal text-ink' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                                    Statistiques
                                </a>
                                <a href="{{ path('workspace_report', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') starts with 'workspace_report' or app.request.attributes.get('_route') starts with 'workspace_monitor_report' ? 'border-signal text-ink' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                                    Rapports
                                </a>
                            </nav>
                        {% endif %}
                    </div>

                    {% if app.user %}
                        <div class="hidden sm:flex sm:items-center sm:gap-4">
                            {% if workspace is defined and workspace %}
                                <div class="relative" data-controller="dropdown">
                                    <button type="button" data-action="click->dropdown#toggle" data-dropdown-target="button"
                                            class="flex items-center gap-1 text-sm font-medium text-ink-muted hover:text-ink border border-line px-3 py-1.5 rounded-sm">
                                        <span class="font-mono">{{ workspace.name }}</span>
                                        {{ ux_icon('heroicons:chevron-down', {class: 'w-4 h-4'}) }}
                                    </button>
                                    <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-56 bg-white border border-line shadow-lg z-10">
                                        <ul class="py-1">
                                            {% for ws in workspaces|default([]) %}
                                                <li>
                                                    <a href="{{ path('workspace_dashboard_index', {workspacePublicId: ws.publicId}) }}"
                                                       class="block px-4 py-2 text-sm {{ ws.publicId == workspace.publicId ? 'text-signal-dark font-semibold' : 'text-ink hover:bg-paper-dim' }}">
                                                        {{ ws.name }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                        <div class="border-t border-line py-1">
                                            <a href="{{ path('workspace_edit', {workspacePublicId: workspace.publicId}) }}" class="block px-4 py-2 text-sm text-ink-muted hover:bg-paper-dim">Renommer ce workspace</a>
                                            <a href="{{ path('workspace_new') }}" class="block px-4 py-2 text-sm text-signal hover:bg-paper-dim">+ Créer un workspace</a>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            <span class="font-mono text-xs text-ink-muted">{{ app.user.userIdentifier }}</span>
                            <a href="{{ path('app_logout') }}" class="text-sm font-medium text-ink-muted hover:text-ink">Déconnexion</a>
                        </div>
                    {% endif %}

                    <div class="flex items-center sm:hidden">
                        <button type="button" data-action="click->mobile-nav#toggle" data-mobile-nav-target="button" aria-expanded="false" aria-controls="mobile-nav-panel"
                                class="inline-flex items-center justify-center p-2 text-ink-muted hover:text-ink border border-line">
                            <span class="sr-only">Ouvrir le menu</span>
                            <span data-mobile-nav-target="iconOpen">{{ ux_icon('heroicons:bars-3', {class: 'w-6 h-6'}) }}</span>
                            <span data-mobile-nav-target="iconClose" class="hidden">{{ ux_icon('heroicons:x-mark', {class: 'w-6 h-6'}) }}</span>
                        </button>
                    </div>
                </div>
            </div>

            <div id="mobile-nav-panel" data-mobile-nav-target="panel" class="hidden sm:hidden border-t border-line">
                {% if workspace is defined and workspace %}
                    <nav class="px-4 pt-2 pb-3 space-y-1">
                        <a href="{{ path('workspace_dashboard_index', {workspacePublicId: workspace.publicId}) }}" class="block px-3 py-2 text-base font-medium border-l-4 {{ app.request.attributes.get('_route') == 'workspace_dashboard_index' ? 'border-signal text-ink bg-paper-dim' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                            Dashboard
                        </a>
                        <a href="{{ path('workspace_availability_index', {workspacePublicId: workspace.publicId}) }}" class="block px-3 py-2 text-base font-medium border-l-4 {{ app.request.attributes.get('_route') starts with 'workspace_availability' or app.request.attributes.get('_route') starts with 'workspace_monitor' or app.request.attributes.get('_route') == 'workspace_rule_new' ? 'border-signal text-ink bg-paper-dim' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                            Disponibilité
                        </a>
                        <a href="{{ path('workspace_analytics_index', {workspacePublicId: workspace.publicId}) }}" class="block px-3 py-2 text-base font-medium border-l-4 {{ app.request.attributes.get('_route') starts with 'workspace_analytics' ? 'border-signal text-ink bg-paper-dim' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                            Analytics
                        </a>
                        <a href="{{ path('workspace_report', {workspacePublicId: workspace.publicId}) }}" class="block px-3 py-2 text-base font-medium border-l-4 {{ app.request.attributes.get('_route') starts with 'workspace_report' or app.request.attributes.get('_route') starts with 'workspace_monitor_report' ? 'border-signal text-ink bg-paper-dim' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                            BI
                        </a>
                    </nav>
                {% endif %}
                {% if app.user %}
                    <div class="border-t border-line px-4 py-3 space-y-3">
                        {% if workspace is defined and workspace %}
                            <div>
                                <p class="font-mono text-xs font-medium text-ink-muted uppercase tracking-wide mb-1">Workspace</p>
                                <ul class="space-y-1">
                                    {% for ws in workspaces|default([]) %}
                                        <li>
                                            <a href="{{ path('workspace_dashboard_index', {workspacePublicId: ws.publicId}) }}"
                                               class="block text-sm {{ ws.publicId == workspace.publicId ? 'text-signal-dark font-semibold' : 'text-ink-muted hover:text-ink' }}">
                                                {{ ws.name }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                                <a href="{{ path('workspace_new') }}" class="block mt-2 text-sm text-signal hover:text-signal-dark">+ Create workspace</a>
                            </div>
                        {% endif %}
                        <div class="flex items-center justify-between border-t border-line pt-3">
                            <span class="font-mono text-xs text-ink-muted">{{ app.user.userIdentifier }}</span>
                            <a href="{{ path('app_logout') }}" class="text-sm font-medium text-ink-muted hover:text-ink">Déconnexion</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </header>

        <main style="min-height: calc(100vh - 4rem);">
            <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
                {# Display Flash Messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 mx-4 sm:mx-0 p-4 border {{ label == 'success' ? 'bg-signal/5 border-signal/30 text-signal-dark' : 'bg-alert/5 border-alert/30 text-alert' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </main>

        <footer class="bg-paper-dim border-t border-line py-4">
            <div class="max-w-7xl mx-auto px-4 text-center font-mono text-[11px] text-ink-muted">
                &copy; 2026 SiteTrack. Suite d'opérations minimaliste pour solopreneurs.
            </div>
        </footer>
    </body>
</html>
