<!DOCTYPE html>
<html class="h-full bg-paper text-ink">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}SiteTrack - Solopreneur Ops Suite{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📡</text></svg>">

        {% block stylesheets %}{% include 'components/_stylesheets.html.twig' %}{% endblock %}

        {% block javascripts %}{% block importmap %}{% include 'components/_importmap.html.twig' %}{% endblock %}{% endblock %}
    </head>
    <body class="h-full flex flex-col font-body antialiased">
        {% import 'components/_macros.html.twig' as m %}
        <header class="bg-white border-b border-line shrink-0">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex">
                        <div class="flex-shrink-0 flex items-center">
                            {{ m.brand_mark() }}
                        </div>
                        {% if workspace is defined and workspace %}
                            <nav class="ml-6 flex space-x-8">
                                <a href="{{ path('workspace_dashboard_index', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') == 'workspace_dashboard_index' ? 'border-signal text-ink' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                                    Dashboard
                                </a>
                                <a href="{{ path('workspace_availability_index', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') starts with 'workspace_availability' or app.request.attributes.get('_route') starts with 'workspace_monitor' or app.request.attributes.get('_route') == 'workspace_rule_new' ? 'border-signal text-ink' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                                    Disponibilité
                                </a>
                                <a href="{{ path('workspace_analytics_index', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium {{ app.request.attributes.get('_route') starts with 'workspace_analytics' ? 'border-signal text-ink' : 'border-transparent text-ink-muted hover:border-line hover:text-ink' }}">
                                    Analytics
                                </a>
                            </nav>
                        {% endif %}
                    </div>
                    {% if app.user %}
                        <div class="flex items-center gap-4">
                            {% if workspace is defined and workspace %}
                                <div class="relative" data-controller="dropdown">
                                    <button type="button" data-action="click->dropdown#toggle" data-dropdown-target="button"
                                            class="flex items-center gap-1 text-sm font-medium text-ink-muted hover:text-ink border border-line px-3 py-1.5 rounded-sm">
                                        <span class="font-mono">{{ workspace.name }}</span>
                                        {{ ux_icon('heroicons:chevron-down', {class: 'w-4 h-4'}) }}
                                    </button>
                                    <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-56 bg-white border border-line shadow-lg z-10">
                                        <ul class="py-1">
                                            {% for ws in workspaces|default([]) %}
                                                <li>
                                                    <a href="{{ path('workspace_dashboard_index', {workspacePublicId: ws.publicId}) }}"
                                                       class="block px-4 py-2 text-sm {{ ws.publicId == workspace.publicId ? 'text-signal-dark font-semibold' : 'text-ink hover:bg-paper-dim' }}">
                                                        {{ ws.name }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                        <div class="border-t border-line py-1">
                                            <a href="{{ path('workspace_edit', {workspacePublicId: workspace.publicId}) }}" class="block px-4 py-2 text-sm text-ink-muted hover:bg-paper-dim">Rename this workspace</a>
                                            <a href="{{ path('workspace_new') }}" class="block px-4 py-2 text-sm text-signal hover:bg-paper-dim">+ Create workspace</a>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            <span class="font-mono text-xs text-ink-muted">{{ app.user.userIdentifier }}</span>
                            <a href="{{ path('app_logout') }}" class="text-sm font-medium text-ink-muted hover:text-ink">Log out</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto">
            <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
                {# Display Flash Messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 mx-4 sm:mx-0 p-4 border {{ label == 'success' ? 'bg-signal/5 border-signal/30 text-signal-dark' : 'bg-alert/5 border-alert/30 text-alert' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </main>

        <footer class="bg-paper-dim border-t border-line py-4 shrink-0">
            <div class="max-w-7xl mx-auto px-4 text-center font-mono text-[11px] text-ink-muted">
                &copy; 2026 SiteTrack. Minimalist Operations Suite for Solopreneurs.
            </div>
        </footer>
    </body>
</html>
