<!DOCTYPE html>
<html lang="fr" class="h-full bg-paper text-ink">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}SiteTrack — Suite de supervision pour solopreneurs{% endblock %}</title>
        <meta name="description" content="{% block description %}SiteTrack surveille la disponibilité de votre site, la délivrabilité de vos emails SMTP et votre trafic — sans cookies — dans un seul tableau de bord pensé pour les solopreneurs.{% endblock %}">
        <link rel="canonical" href="{{ app.request.uri }}">
        <meta name="theme-color" content="#0E7C6B">

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="SiteTrack">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:url" content="{{ app.request.uri }}">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
        <meta property="og:image" content="{{ absolute_url(asset('images/og-image.png')) }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Aperçu du tableau de bord SiteTrack">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('description') }}">
        <meta name="twitter:image" content="{{ absolute_url(asset('images/og-image.png')) }}">

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📡</text></svg>">

        {% block stylesheets %}{% include 'components/_stylesheets.html.twig' %}{% endblock %}
        {% block javascripts %}{% include 'components/_importmap.html.twig' %}{% endblock %}
    </head>
    <body class="h-full flex flex-col font-body antialiased">
        {% include 'home/_header.html.twig' %}

        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>

        {% include 'home/_footer.html.twig' %}
    </body>
</html>
