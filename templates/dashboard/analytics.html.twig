{% extends 'base.html.twig' %}

{% block title %}Analytics Dashboard - SiteTrack{% endblock %}

{% block body %}
<div class="px-4 sm:px-0 mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-display font-bold tracking-tight text-ink">Simple Web Analytics</h1>
        <p class="mt-1 text-sm font-body text-ink-muted">Privacy-first, cookie-less website analytics. No cookies stored, ever.</p>
    </div>
    {% include 'dashboard/analytics/_filters.html.twig' %}
</div>

<div class="px-4 sm:px-0 space-y-6">
    <div class="bg-white border border-line">
        <div class="px-6 py-5 border-b border-line overflow-x-auto">
            {% include 'dashboard/analytics/_kpi_row.html.twig' %}
        </div>
        <div class="p-6">
            {% include 'dashboard/analytics/_chart.html.twig' %}
        </div>
    </div>
    {% include 'dashboard/analytics/_channels.html.twig' %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {% include 'dashboard/analytics/_pages.html.twig' %}
        {% include 'dashboard/analytics/_geo.html.twig' %}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {% include 'dashboard/analytics/_tech.html.twig' %}

        <div class="bg-white border border-line p-6">
            <h3 class="font-mono text-xs font-bold text-ink uppercase tracking-wider mb-2">Tracked Site ID</h3>
            <code class="block w-full rounded bg-paper-dim border border-line text-xs p-2 text-ink mb-4">{{ siteId }}</code>

            <h3 class="font-mono text-xs font-bold text-ink uppercase tracking-wider mb-3">Install script</h3>
            <p class="text-xs text-ink-muted mb-4">Paste this lightweight tracking script into the <code>&lt;head&gt;</code> of your website.</p>
            <div class="bg-ink text-paper font-mono text-[10px] p-3 rounded overflow-x-auto leading-relaxed">
                &lt;script src="{{ app.request.schemeAndHttpHost }}/collect/event.js" data-site="{{ siteId }}" async&gt;&lt;/script&gt;
            </div>
        </div>
    </div>
</div>
{% endblock %}
