{% extends 'base.html.twig' %}

{% block title %}Analytics Dashboard - SiteTrack{% endblock %}

{% block body %}
<div class="px-4 sm:px-0 mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Simple Web Analytics</h1>
    <p class="mt-1 text-sm text-slate-500">Privacy-first, cookie-less website analytics. No cookies stored, ever.</p>
</div>

<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    <!-- Left Panel: stats and script -->
    <div class="lg:col-span-1 space-y-6">
        <!-- Site Selection / Info -->
        <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6">
            <label for="site_id_select" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Tracked Site ID</label>
            <form method="GET" action="{{ path('analytics_index') }}" class="flex gap-2">
                <input type="text" name="site_id" id="site_id_select" value="{{ siteId }}" required
                       class="block w-full rounded border-slate-300 text-xs p-2 border">
                <button type="submit" class="inline-flex items-center px-3 py-2 border border-transparent text-xs font-semibold rounded text-white bg-indigo-600 hover:bg-indigo-700">
                    Filter
                </button>
            </form>
        </div>

        <!-- Ingestion stats card -->
        <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6 grid grid-cols-2 gap-4">
            <div class="bg-slate-50 p-4 rounded border border-slate-100">
                <span class="block text-[10px] font-semibold text-slate-400 uppercase">Unique Visitors</span>
                <span class="text-2xl font-extrabold text-slate-900 mt-1 block">{{ uniqueVisitors }}</span>
            </div>
            <div class="bg-slate-50 p-4 rounded border border-slate-100">
                <span class="block text-[10px] font-semibold text-slate-400 uppercase">Pageviews</span>
                <span class="text-2xl font-extrabold text-slate-900 mt-1 block">{{ pageviews }}</span>
            </div>
        </div>

        <!-- Tracking script insertion -->
        <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6">
            <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-3">Install script</h3>
            <p class="text-xs text-slate-400 mb-4">Paste this lightweight tracking script into the <code>&lt;head&gt;</code> of your website.</p>
            <div class="bg-slate-800 text-slate-300 font-mono text-[10px] p-3 rounded overflow-x-auto leading-relaxed border border-slate-900">
                &lt;script src="{{ app.request.schemeAndHttpHost }}/tracker.js" data-site-id="{{ siteId }}" async&gt;&lt;/script&gt;
            </div>
        </div>
    </div>

    <!-- Right Panel: traffic distribution lists -->
    <div class="lg:col-span-2 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Top Paths -->
            <div class="bg-white shadow-sm rounded-lg border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Top Pages</h3>
                </div>
                {% if topPages is empty %}
                    <p class="text-xs text-slate-400 p-6 text-center">No page views recorded.</p>
                {% else %}
                    <table class="min-w-full divide-y divide-slate-100 text-xs">
                        <tbody class="divide-y divide-slate-100 bg-white">
                            {% for row in topPages %}
                                <tr class="hover:bg-slate-50">
                                    <td class="px-6 py-3 font-medium text-slate-700 font-mono">{{ row.path }}</td>
                                    <td class="px-6 py-3 text-right text-slate-500 font-semibold">{{ row.count }} views</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>

            <!-- Top Referrers -->
            <div class="bg-white shadow-sm rounded-lg border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Top Referrers</h3>
                </div>
                {% if topReferrers is empty %}
                    <p class="text-xs text-slate-400 p-6 text-center">No referrers logged.</p>
                {% else %}
                    <table class="min-w-full divide-y divide-slate-100 text-xs">
                        <tbody class="divide-y divide-slate-100 bg-white">
                            {% for row in topReferrers %}
                                <tr class="hover:bg-slate-50">
                                    <td class="px-6 py-3 font-medium text-slate-700 truncate max-w-xs">{{ row.referrer ?: 'direct' }}</td>
                                    <td class="px-6 py-3 text-right text-slate-500 font-semibold">{{ row.count }} views</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>

        <!-- Geographic Distribution -->
        <div class="bg-white shadow-sm rounded-lg border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Top Countries</h3>
            </div>
            {% if countries is empty %}
                <p class="text-xs text-slate-400 p-6 text-center">No geographic stats collected.</p>
            {% else %}
                <table class="min-w-full divide-y divide-slate-100 text-xs">
                    <tbody class="divide-y divide-slate-100 bg-white">
                        {% for row in countries %}
                            <tr class="hover:bg-slate-50">
                                <td class="px-6 py-3 font-medium text-slate-700">🌍 {{ row.country ?: 'Unknown' }}</td>
                                <td class="px-6 py-3 text-right text-slate-500 font-semibold">{{ row.count }} visitors</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
