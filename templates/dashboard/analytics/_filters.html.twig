<form method="GET" action="{{ path('analytics_index') }}" data-controller="auto-submit" class="flex items-center gap-3">
    <select name="period" data-action="change->auto-submit#submit"
            class="rounded-md border-slate-300 text-sm py-2 pl-3 pr-8 focus:border-indigo-500 focus:ring-indigo-500">
        <option value="today" {{ period == 'today' ? 'selected' : '' }}>Today</option>
        <option value="24h" {{ period == '24h' ? 'selected' : '' }}>Last 24 hours</option>
        <option value="7d" {{ period == '7d' ? 'selected' : '' }}>Last 7 days</option>
        <option value="30d" {{ period == '30d' ? 'selected' : '' }}>Last 30 days</option>
    </select>
    <select name="granularity" data-action="change->auto-submit#submit"
            class="rounded-md border-slate-300 text-sm py-2 pl-3 pr-8 focus:border-indigo-500 focus:ring-indigo-500">
        <option value="hourly" {{ granularity == 'hourly' ? 'selected' : '' }}>Hourly</option>
        <option value="daily" {{ granularity == 'daily' ? 'selected' : '' }}>Daily</option>
    </select>
</form>
