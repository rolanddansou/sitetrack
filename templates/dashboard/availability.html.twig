{% extends 'base.html.twig' %}

{% block title %}Disponibilité - SiteTrack{% endblock %}

{% block body %}
<div class="px-4 sm:px-0 flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-display font-bold tracking-tight text-ink">Uptime & SMTP Monitors</h1>
        <p class="mt-1 text-sm font-body text-ink-muted">Real-time health status of your apps and transactional mail servers.</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="{{ path('workspace_report', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-4 py-2 border border-line text-sm font-body font-semibold rounded-sm text-ink bg-white hover:bg-paper-dim focus:outline-none">
            Workspace Report
        </a>
        <a href="{{ path('workspace_monitor_new', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-body font-semibold rounded-sm text-paper bg-signal hover:bg-signal-dark focus:outline-none">
            Add Monitor
        </a>
    </div>
</div>

{% if monitors is empty %}
<div class="text-center py-12 bg-white border border-line mx-4 sm:mx-0">
    {{ ux_icon('heroicons:signal', {class: 'w-10 h-10 text-signal mx-auto'}) }}
    <h3 class="mt-2 text-sm font-body font-semibold text-ink">No monitors configured</h3>
    <p class="mt-1 text-sm font-body text-ink-muted">Get started by creating your first health-check or SMTP monitor.</p>
    <div class="mt-6">
        <a href="{{ path('workspace_monitor_new', {workspacePublicId: workspace.publicId}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-body font-semibold rounded-sm text-paper bg-signal hover:bg-signal-dark">
            Create Monitor
        </a>
    </div>
</div>
{% else %}
<div class="bg-white border border-line overflow-hidden mx-4 sm:mx-0">
    <ul role="list" class="divide-y divide-line">
        {% for item in monitors %}
            {% set monitor = item.entity %}
            {% set check = item.lastCheck %}
            {% set smtp = item.lastSmtp %}

            <li class="hover:bg-paper-dim transition-colors">
                <a href="{{ path('workspace_monitor_show', {workspacePublicId: workspace.publicId, monitorPublicId: monitor.publicId}) }}" class="block px-6 py-4">
                    <div class="flex items-center justify-between flex-wrap sm:flex-nowrap gap-4">
                        <div class="flex items-center space-x-3">
                            <span class="w-8 h-8 border border-line text-signal flex items-center justify-center shrink-0">
                                {{ ux_icon(monitor.type == 'http' ? 'heroicons:globe-alt' : 'heroicons:envelope', {class: 'w-4 h-4'}) }}
                            </span>
                            <div>
                                <h4 class="text-sm font-body font-bold text-ink">{{ monitor.name }}</h4>
                                <p class="font-mono text-xs text-ink-muted truncate max-w-md">{{ monitor.target }}</p>
                            </div>
                        </div>

                        <div class="flex items-center space-x-6 shrink-0">
                            {# Response Speed #}
                            <div class="text-right hidden sm:block">
                                {% if monitor.type == 'http' and check %}
                                    <span class="text-xs text-ink-muted block">Latency</span>
                                    <span class="font-mono text-sm font-semibold text-ink">{{ check.responseTimeMs }} ms</span>
                                {% elseif monitor.type == 'smtp' and smtp %}
                                    <span class="text-xs text-ink-muted block">Delivery Speed</span>
                                    <span class="font-mono text-sm font-semibold text-ink">
                                        {% if smtp.status == 'delivered' %}
                                            {{ smtp.delivery_time_seconds }} s
                                        {% else %}
                                            --
                                        {% endif %}
                                    </span>
                                {% endif %}
                            </div>

                            {# Status Badge #}
                            <div>
                                {% if monitor.type == 'http' %}
                                    {% if check is null %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-xs font-semibold bg-paper-dim text-ink-muted">Pending</span>
                                    {% elseif check.status == 'up' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-xs font-semibold bg-signal/10 text-signal-dark">● UP</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-xs font-semibold bg-alert/10 text-alert">● DOWN</span>
                                    {% endif %}
                                {% else %}
                                    {% if smtp is null %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-xs font-semibold bg-paper-dim text-ink-muted">Pending</span>
                                    	{% elseif smtp.status == 'delivered' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-xs font-semibold bg-signal/10 text-signal-dark">● DELIVERED</span>
                                    {% elseif smtp.status == 'sent' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-xs font-semibold bg-paper-dim text-ink-muted">● SENT</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-xs font-semibold bg-alert/10 text-alert">● FAILED</span>
                                    {% endif %}
                                {% endif %}
                            </div>

                            {{ ux_icon('heroicons:chevron-right', {class: 'h-5 w-5 text-ink-muted'}) }}
                        </div>
                    </div>
                </a>
            </li>
        {% endfor %}
    </ul>
</div>
{% endif %}
{% endblock %}
