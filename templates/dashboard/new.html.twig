{% extends 'base.html.twig' %}

{% block title %}Nouveau moniteur - SiteTrack{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-0">
    <div class="mb-6">
        <a href="{{ path('workspace_availability_index', {workspacePublicId: workspace.publicId}) }}" class="text-xs text-signal hover:text-signal-dark flex items-center gap-1 mb-2">
            &larr; Retour au tableau de bord
        </a>
        <h1 class="text-2xl font-display font-bold tracking-tight text-ink">Créer un nouveau moniteur</h1>
        <p class="text-sm font-body text-ink-muted">Ajoutez une nouvelle URL à surveiller ou des identifiants SMTP à vérifier.</p>
    </div>

    <div class="bg-white border border-line p-6">
        <form method="POST" action="{{ path('workspace_monitor_new', {workspacePublicId: workspace.publicId}) }}" class="space-y-6" data-controller="monitor-type">
            <div>
                <label for="name" class="block text-sm font-body font-semibold text-ink">Nom du moniteur</label>
                <input type="text" name="name" id="name" value="{{ dto.name }}" required
                       class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                {% if errors.name is defined %}
                    <p class="mt-1 text-xs text-alert">{{ errors.name }}</p>
                {% endif %}
            </div>

            <div>
                <label for="type" class="block text-sm font-body font-semibold text-ink">Type de moniteur</label>
                <select name="type" id="type" data-monitor-type-target="typeSelect" data-action="change->monitor-type#toggle"
                        class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                    <option value="http" {{ dto.type == 'http' ? 'selected' : '' }}>Ping HTTP(S)</option>
                    <option value="smtp" {{ dto.type == 'smtp' ? 'selected' : '' }}>Vérification de délivrabilité SMTP</option>
                </select>
                {% if errors.type is defined %}
                    <p class="mt-1 text-xs text-alert">{{ errors.type }}</p>
                {% endif %}
            </div>

            <div>
                <label data-monitor-type-target="targetLabel" for="target" class="block text-sm font-body font-semibold text-ink">URL cible</label>
                <input type="text" name="target" id="target" value="{{ dto.target }}" required
                       class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                <span data-monitor-type-target="targetHelp" class="text-xs text-ink-muted mt-1 block"></span>
                {% if errors.target is defined %}
                    <p class="mt-1 text-xs text-alert">{{ errors.target }}</p>
                {% endif %}
            </div>

            <div>
                <label for="interval" class="block text-sm font-body font-semibold text-ink">Intervalle de vérification (minutes)</label>
                <select name="interval" id="interval"
                        class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                    <option value="1" {{ dto.interval == 1 ? 'selected' : '' }}>Toutes les 1 minute</option>
                    <option value="5" {{ dto.interval == 5 ? 'selected' : '' }}>Toutes les 5 minutes</option>
                    <option value="15" {{ dto.interval == 15 ? 'selected' : '' }}>Toutes les 15 minutes</option>
                    <option value="30" {{ dto.interval == 30 ? 'selected' : '' }}>Toutes les 30 minutes</option>
                    <option value="60" {{ dto.interval == 60 ? 'selected' : '' }}>Toutes les heures</option>
                </select>
                {% if errors.interval is defined %}
                    <p class="mt-1 text-xs text-alert">{{ errors.interval }}</p>
                {% endif %}
            </div>

            {# HTTP Specific Fields #}
            <div data-monitor-type-target="httpFields" class="space-y-6">
                <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-4">
                    <div>
                        <label for="expected_status" class="block text-sm font-body font-semibold text-ink">Statut HTTP attendu</label>
                        <input type="number" name="expected_status" id="expected_status" value="{{ dto.expectedStatus }}"
                               class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                        {% if errors.expectedStatus is defined %}
                            <p class="mt-1 text-xs text-alert">{{ errors.expectedStatus }}</p>
                        {% endif %}
                    </div>
                </div>

                <div>
                    <label for="regex_check" class="block text-sm font-body font-semibold text-ink">Motif regex à vérifier (optionnel)</label>
                    <input type="text" name="regex_check" id="regex_check" value="{{ dto.regexCheck }}" placeholder="/Success/"
                           class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                    <span class="text-xs text-ink-muted mt-1 block">Vérifie que le corps de la réponse contient un motif de texte spécifique.</span>
                    {% if errors.regexCheck is defined %}
                        <p class="mt-1 text-xs text-alert">{{ errors.regexCheck }}</p>
                    {% endif %}
                </div>
            </div>

            {# SMTP Specific Fields #}
            <div data-monitor-type-target="smtpFields" class="space-y-6 hidden">
                <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-4">
                    <div>
                        <label for="smtp_username" class="block text-sm font-body font-semibold text-ink">Identifiant / email SMTP</label>
                        <input type="text" name="smtp_username" id="smtp_username" value="{{ dto.smtpUsername }}"
                               class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                        {% if errors.smtpUsername is defined %}
                            <p class="mt-1 text-xs text-alert">{{ errors.smtpUsername }}</p>
                        {% endif %}
                    </div>

                    <div>
                        <label for="smtp_password" class="block text-sm font-body font-semibold text-ink">Mot de passe SMTP</label>
                        <input type="password" name="smtp_password" id="smtp_password"
                               class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                        {% if errors.smtpPassword is defined %}
                            <p class="mt-1 text-xs text-alert">{{ errors.smtpPassword }}</p>
                        {% endif %}
                    </div>
                </div>

                <div>
                    <label for="smtp_secure" class="block text-sm font-body font-semibold text-ink">Méthode de chiffrement</label>
                    <select name="smtp_secure" id="smtp_secure"
                            class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                        <option value="" {{ dto.smtpSecure == '' ? 'selected' : '' }}>Opportuniste (STARTTLS - défaut)</option>
                        <option value="ssl" {{ dto.smtpSecure == 'ssl' ? 'selected' : '' }}>SSL/TLS (port 465)</option>
                    </select>
                    {% if errors.smtpSecure is defined %}
                        <p class="mt-1 text-xs text-alert">{{ errors.smtpSecure }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="pt-4 flex justify-end gap-3 border-t border-line">
                <a href="{{ path('workspace_availability_index', {workspacePublicId: workspace.publicId}) }}" class="px-4 py-2 border border-ink/20 text-sm font-body font-medium rounded-sm text-ink hover:border-ink/40">
                    Annuler
                </a>
                <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-body font-medium rounded-sm text-paper bg-signal hover:bg-signal-dark">
                    Enregistrer le moniteur
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
