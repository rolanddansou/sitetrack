{% extends 'base.html.twig' %}

{% block title %}Dashboard - SiteTrack{% endblock %}

{% block body %}
<div class="px-4 sm:px-0 mb-6">
    <h1 class="text-2xl font-display font-bold tracking-tight text-ink">Dashboard</h1>
    <p class="mt-1 text-sm font-body text-ink-muted">Aperçu de la disponibilité de vos moniteurs et de votre trafic.</p>
</div>

<div class="px-4 sm:px-0 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white border border-line p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-mono text-sm font-bold text-ink uppercase tracking-wider">Disponibilité</h2>
            <a href="{{ path('workspace_availability_index', {workspacePublicId: workspace.publicId}) }}" class="text-xs font-medium text-signal hover:text-signal-dark">Voir tout →</a>
        </div>

        {% if monitorSummary.total == 0 %}
            <p class="text-sm text-ink-muted">Aucun moniteur configuré pour le moment.</p>
            <a href="{{ path('workspace_monitor_new', {workspacePublicId: workspace.publicId}) }}" class="mt-3 inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-sm text-paper bg-signal hover:bg-signal-dark">
                Créer un moniteur
            </a>
        {% else %}
            <div class="grid grid-cols-3 divide-x divide-line">
                <div class="text-center" data-summary="monitors-up">
                    <p class="text-2xl font-mono font-bold text-signal-dark tabular-nums">{{ monitorSummary.up }}</p>
                    <p class="mt-1 text-xs font-medium text-ink-muted">En ligne</p>
                </div>
                <div class="text-center" data-summary="monitors-down">
                    <p class="text-2xl font-mono font-bold text-alert tabular-nums">{{ monitorSummary.down }}</p>
                    <p class="mt-1 text-xs font-medium text-ink-muted">En panne</p>
                </div>
                <div class="text-center" data-summary="monitors-pending">
                    <p class="text-2xl font-mono font-bold text-ink-muted tabular-nums">{{ monitorSummary.pending }}</p>
                    <p class="mt-1 text-xs font-medium text-ink-muted">En attente</p>
                </div>
            </div>
        {% endif %}
    </div>

    <div class="bg-white border border-line p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-mono text-sm font-bold text-ink uppercase tracking-wider">Analytics <span class="text-ink-muted font-normal normal-case">· 7 derniers jours</span></h2>
            <a href="{{ path('workspace_analytics_index', {workspacePublicId: workspace.publicId}) }}" class="text-xs font-medium text-signal hover:text-signal-dark">Voir tout →</a>
        </div>

        <div class="grid grid-cols-3 divide-x divide-line">
            <div class="text-center" data-summary="analytics-visitors">
                <p class="text-2xl font-mono font-bold text-ink tabular-nums">{{ analyticsSummary.visitors }}</p>
                <p class="mt-1 text-xs font-medium text-ink-muted">Visiteurs</p>
            </div>
            <div class="text-center" data-summary="analytics-pageviews">
                <p class="text-2xl font-mono font-bold text-ink tabular-nums">{{ analyticsSummary.pageviews }}</p>
                <p class="mt-1 text-xs font-medium text-ink-muted">Pages vues</p>
            </div>
            <div class="text-center" data-summary="analytics-bounce-rate">
                <p class="text-2xl font-mono font-bold text-ink tabular-nums">{{ analyticsSummary.bounceRate }}%</p>
                <p class="mt-1 text-xs font-medium text-ink-muted">Taux de rebond</p>
            </div>
        </div>
    </div>
</div>

<div class="px-4 sm:px-0 mt-6">
    {% include 'dashboard/_live_globe.html.twig' %}
</div>

<div class="px-4 sm:px-0 mt-6">
    <div class="bg-white border border-line">
        <div class="px-6 py-4 border-b border-line">
            <h2 class="font-mono text-sm font-bold text-ink uppercase tracking-wider">Dernière activité</h2>
        </div>

        {% if recentActivity is empty %}
            <p class="px-6 py-6 text-sm text-ink-muted">Aucune activité récente.</p>
        {% else %}
            <ul class="divide-y divide-line" data-activity-list>
                {% for item in recentActivity %}
                    <li class="px-6 py-3 flex items-center justify-between gap-4" data-activity-item>
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="w-2 h-2 rounded-full shrink-0 {{ item.status == 'resolved' ? 'bg-signal' : 'bg-alert' }}"></span>
                            <a href="{{ path('workspace_monitor_show', {workspacePublicId: workspace.publicId, monitorPublicId: item.monitorPublicId}) }}" class="text-sm font-medium text-ink truncate hover:text-signal">{{ item.monitorName }}</a>
                            <span class="text-sm text-ink-muted shrink-0">{{ item.status == 'resolved' ? 'rétabli' : 'en panne' }}</span>
                        </div>
                        <span class="font-mono text-xs text-ink-muted shrink-0">{{ item.relativeTime }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}
