{% extends 'base.html.twig' %}

{% block title %}Dashboard - SiteTrack{% endblock %}

{% block body %}
<div class="px-4 sm:px-0 mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Dashboard</h1>
    <p class="mt-1 text-sm text-slate-500">Aperçu de la disponibilité de vos moniteurs et de votre trafic.</p>
</div>

<div class="px-4 sm:px-0 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Disponibilité</h2>
            <a href="{{ path('availability_index') }}" class="text-xs font-medium text-indigo-600 hover:text-indigo-900">Voir tout →</a>
        </div>

        {% if monitorSummary.total == 0 %}
            <p class="text-sm text-slate-500">Aucun moniteur configuré pour le moment.</p>
            <a href="{{ path('monitor_new') }}" class="mt-3 inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700">
                Créer un moniteur
            </a>
        {% else %}
            <div class="grid grid-cols-3 divide-x divide-slate-100">
                <div class="text-center" data-summary="monitors-up">
                    <p class="text-2xl font-bold text-green-600">{{ monitorSummary.up }}</p>
                    <p class="mt-1 text-xs font-medium text-slate-500">En ligne</p>
                </div>
                <div class="text-center" data-summary="monitors-down">
                    <p class="text-2xl font-bold text-red-500">{{ monitorSummary.down }}</p>
                    <p class="mt-1 text-xs font-medium text-slate-500">En panne</p>
                </div>
                <div class="text-center" data-summary="monitors-pending">
                    <p class="text-2xl font-bold text-slate-400">{{ monitorSummary.pending }}</p>
                    <p class="mt-1 text-xs font-medium text-slate-500">En attente</p>
                </div>
            </div>
        {% endif %}
    </div>

    <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Analytics <span class="text-slate-400 font-normal normal-case">· 7 derniers jours</span></h2>
            <a href="{{ path('analytics_index') }}" class="text-xs font-medium text-indigo-600 hover:text-indigo-900">Voir tout →</a>
        </div>

        <div class="grid grid-cols-3 divide-x divide-slate-100">
            <div class="text-center" data-summary="analytics-visitors">
                <p class="text-2xl font-bold text-slate-900">{{ analyticsSummary.visitors }}</p>
                <p class="mt-1 text-xs font-medium text-slate-500">Visiteurs</p>
            </div>
            <div class="text-center" data-summary="analytics-pageviews">
                <p class="text-2xl font-bold text-slate-900">{{ analyticsSummary.pageviews }}</p>
                <p class="mt-1 text-xs font-medium text-slate-500">Pages vues</p>
            </div>
            <div class="text-center" data-summary="analytics-bounce-rate">
                <p class="text-2xl font-bold text-slate-900">{{ analyticsSummary.bounceRate }}%</p>
                <p class="mt-1 text-xs font-medium text-slate-500">Taux de rebond</p>
            </div>
        </div>
    </div>
</div>

<div class="px-4 sm:px-0 mt-6">
    <div class="bg-white shadow-sm rounded-lg border border-slate-200">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Dernière activité</h2>
        </div>

        {% if recentActivity is empty %}
            <p class="px-6 py-6 text-sm text-slate-500">Aucune activité récente.</p>
        {% else %}
            <ul class="divide-y divide-slate-100" data-activity-list>
                {% for item in recentActivity %}
                    <li class="px-6 py-3 flex items-center justify-between gap-4" data-activity-item>
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="w-2 h-2 rounded-full shrink-0 {{ item.status == 'resolved' ? 'bg-green-500' : 'bg-red-500' }}"></span>
                            <a href="{{ path('monitor_show', {publicId: item.monitorPublicId}) }}" class="text-sm font-medium text-slate-900 truncate hover:text-indigo-600">{{ item.monitorName }}</a>
                            <span class="text-sm text-slate-500 shrink-0">{{ item.status == 'resolved' ? 'rétabli' : 'en panne' }}</span>
                        </div>
                        <span class="text-xs text-slate-400 shrink-0">{{ item.relativeTime }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
{% endblock %}
