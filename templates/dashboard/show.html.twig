{% extends 'base.html.twig' %}

{% block title %}{{ monitor.name }} - Détails - SiteTrack{% endblock %}

{% block body %}
<div class="px-4 sm:px-0">
    <div class="mb-6 flex justify-between items-start">
        <div>
            <a href="{{ path('workspace_availability_index', {workspacePublicId: workspace.publicId}) }}" class="text-xs text-signal hover:text-signal-dark flex items-center gap-1 mb-2">
                &larr; Retour au tableau de bord
            </a>
            <h1 class="text-2xl font-display font-bold tracking-tight text-ink flex items-center gap-2">
                {{ ux_icon(monitor.type == 'http' ? 'heroicons:globe-alt' : 'heroicons:envelope', {class: 'w-6 h-6 text-signal'}) }}
                <span>{{ monitor.name }}</span>
            </h1>
            <p class="text-sm font-body text-ink-muted mt-1">Intervalle de vérification : toutes les {{ monitor.interval }} minutes.</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="{{ path('workspace_monitor_report', {workspacePublicId: workspace.publicId, monitorPublicId: monitor.publicId}) }}" class="inline-flex items-center px-3 py-1.5 border border-line text-xs font-body font-semibold rounded-sm text-ink bg-white hover:bg-paper-dim">
                Rapport
            </a>
            <form method="POST" action="{{ path('workspace_monitor_delete', {workspacePublicId: workspace.publicId, monitorPublicId: monitor.publicId}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce moniteur ? Cela supprimera aussi tous ses journaux.')">
                <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-alert/40 text-xs font-body font-semibold rounded-sm text-alert bg-white hover:bg-alert/5 focus:outline-none">
                    Supprimer le moniteur
                </button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3"
         data-controller="monitor-live"
         data-monitor-live-url-value="{{ path('workspace_monitor_live', {workspacePublicId: workspace.publicId, monitorPublicId: monitor.publicId}) }}">
        <!-- Main Stats & Chart Column -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Current Status Card -->
            <div class="bg-white border border-line p-6">
                <h3 class="font-mono text-sm font-semibold text-ink-muted uppercase tracking-wider mb-2">Statut actuel</h3>
                <div class="flex items-center space-x-3" data-monitor-live-target="status">
                    {% if monitor.type == 'http' %}
                        {% set lastCheck = recentChecks|first %}
                        {% if lastCheck is empty %}
                            <span class="h-4 w-4 bg-ink-muted rounded-full animate-pulse"></span>
                            <span class="text-lg font-body font-bold text-ink-muted">Aucun ping enregistré pour le moment</span>
                        {% elseif lastCheck.status == 'up' %}
                            <span class="h-4 w-4 bg-signal rounded-full"></span>
                            <span class="text-lg font-body font-bold text-signal-dark">En ligne</span>
                            <span class="text-ink-muted text-xs">(Vérifié à {{ lastCheck.checkedAt|date('H:i:s') }})</span>
                        {% else %}
                            <span class="h-4 w-4 bg-alert rounded-full animate-ping"></span>
                            <span class="text-lg font-body font-bold text-alert">Hors ligne</span>
                            <span class="text-xs text-alert bg-alert/5 px-2 py-0.5 rounded ml-2">{{ lastCheck.errorMessage }}</span>
                        {% endif %}
                    {% else %}
                        {% set lastSmtp = smtpTests|first %}
                        {% if lastSmtp is empty %}
                            <span class="h-4 w-4 bg-ink-muted rounded-full animate-pulse"></span>
                            <span class="text-lg font-body font-bold text-ink-muted">Aucun email de test envoyé pour le moment</span>
                        {% elseif lastSmtp.status == 'delivered' %}
                            <span class="h-4 w-4 bg-signal rounded-full"></span>
                            <span class="text-lg font-body font-bold text-signal-dark">Opérationnel</span>
                            <span class="text-ink-muted text-xs">(Livré en {{ lastSmtp.delivery_time_seconds }}s à {{ lastSmtp.received_at|date('H:i:s') }})</span>
                        {% elseif lastSmtp.status == 'sent' %}
                            <span class="h-4 w-4 bg-ink-muted rounded-full animate-pulse"></span>
                            <span class="text-lg font-body font-bold text-ink-muted">En attente de l'accusé de livraison...</span>
                        {% else %}
                            <span class="h-4 w-4 bg-alert rounded-full"></span>
                            <span class="text-lg font-body font-bold text-alert">Échec / Délai dépassé</span>
                            <span class="text-xs text-alert bg-alert/5 px-2 py-0.5 rounded ml-2">{{ lastSmtp.error_message }}</span>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

            <!-- Performance / History Chart -->
            <div class="bg-white border border-line p-6">
                <h3 class="font-mono text-sm font-semibold text-ink-muted uppercase tracking-wider mb-4">
                    {{ monitor.type == 'http' ? 'Latence de réponse (ms)' : 'Délai de livraison (secondes)' }}
                </h3>

                <div data-monitor-live-target="chart">
                {% if monitor.type == 'http' and recentChecks is not empty %}
                    {% set maxVal = 1 %}
                    {% for c in recentChecks %}
                        {% if c.responseTimeMs > maxVal %}{% set maxVal = c.responseTimeMs %}{% endif %}
                    {% endfor %}
                    <div class="flex items-end gap-1 h-32 pt-4 border-b border-line">
                        {% for c in recentChecks|slice(0, 30)|reverse %}
                            <div class="{{ c.status == 'up' ? 'bg-signal' : 'bg-alert' }} rounded-t flex-1"
                                 style="height: {{ (c.responseTimeMs / maxVal * 100)|round }}%;"
                                 title="{{ c.responseTimeMs }}ms at {{ c.checkedAt|date('H:i:s') }}">
                            </div>
                        {% endfor %}
                    </div>
                    <div class="flex justify-between text-xs text-ink-muted mt-2">
                        <span>Plus ancien</span>
                        <span>Plus récent</span>
                    </div>
                {% elseif monitor.type == 'smtp' and smtpTests is not empty %}
                    {% set maxVal = 1 %}
                    {% for t in smtpTests %}
                        {% if t.delivery_time_seconds > maxVal %}{% set maxVal = t.delivery_time_seconds %}{% endif %}
                    {% endfor %}
                    <div class="flex items-end gap-1 h-32 pt-4 border-b border-line">
                        {% for t in smtpTests|slice(0, 30)|reverse %}
                            {% set pct = t.delivery_time_seconds ? (t.delivery_time_seconds / maxVal * 100)|round : 0 %}
                            <div class="{{ t.status == 'delivered' ? 'bg-signal' : (t.status == 'sent' ? 'bg-ink-muted animate-pulse' : 'bg-alert') }} rounded-t flex-1"
                                 style="height: {{ pct > 0 ? pct : 5 }}%;"
                                 title="{% if t.status == 'delivered' %}{{ t.delivery_time_seconds }}s{% else %}{{ t.status }}{% endif %} at {{ t.sent_at }}">
                            </div>
                        {% endfor %}
                    </div>
                    <div class="flex justify-between text-xs text-ink-muted mt-2">
                        <span>Plus ancien</span>
                        <span>Plus récent</span>
                    </div>
                {% else %}
                    <p class="text-sm text-ink-muted text-center py-6">Pas assez de données pour afficher les métriques.</p>
                {% endif %}
                </div>
            </div>

            <!-- Historical Log Table -->
            <div class="bg-white border border-line overflow-hidden">
                <div class="px-6 py-4 border-b border-line bg-paper-dim">
                    <h3 class="font-mono text-sm font-bold text-ink">Historique des vérifications</h3>
                </div>
                {% if monitor.type == 'http' %}
                    <table class="min-w-full divide-y divide-line text-xs">
                        <thead>
                            <tr class="bg-paper-dim text-ink-muted text-left uppercase">
                                <th class="px-6 py-3 font-semibold">Vérifié à</th>
                                <th class="px-6 py-3 font-semibold">Statut</th>
                                <th class="px-6 py-3 font-semibold">Latence</th>
                                <th class="px-6 py-3 font-semibold">Détails</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line bg-white" data-monitor-live-target="table">
                            {% for c in recentChecks %}
                                <tr>
                                    <td class="px-6 py-3 font-mono text-ink-muted">{{ c.checkedAt|date('Y-m-d H:i:s') }}</td>
                                    <td class="px-6 py-3">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold {{ c.status == 'up' ? 'bg-signal/10 text-signal-dark' : 'bg-alert/10 text-alert' }}">
                                            {{ c.status == 'up' ? 'EN LIGNE' : 'HORS LIGNE' }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-3 font-mono text-ink">{{ c.responseTimeMs }} ms</td>
                                    <td class="px-6 py-3 text-ink-muted truncate max-w-xs">{{ c.errorMessage ?: '--' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <table class="min-w-full divide-y divide-line text-xs">
                        <thead>
                            <tr class="bg-paper-dim text-ink-muted text-left uppercase">
                                <th class="px-6 py-3 font-semibold">Envoyé à</th>
                                <th class="px-6 py-3 font-semibold">Reçu à</th>
                                <th class="px-6 py-3 font-semibold">Délai de livraison</th>
                                <th class="px-6 py-3 font-semibold">Statut</th>
                                <th class="px-6 py-3 font-semibold">En-têtes</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line bg-white" data-monitor-live-target="table">
                            {% for t in smtpTests %}
                                <tr>
                                    <td class="px-6 py-3 font-mono text-ink-muted">{{ t.sent_at }}</td>
                                    <td class="px-6 py-3 font-mono text-ink-muted">{{ t.received_at ?: '--' }}</td>
                                    <td class="px-6 py-3 font-mono text-ink">{{ t.delivery_time_seconds ? t.delivery_time_seconds ~ ' s' : '--' }}</td>
                                    <td class="px-6 py-3">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold {{ t.status == 'delivered' ? 'bg-signal/10 text-signal-dark' : (t.status == 'sent' ? 'bg-paper-dim text-ink-muted' : 'bg-alert/10 text-alert') }}">
                                            {{ t.status == 'delivered' ? 'LIVRÉ' : (t.status == 'sent' ? 'ENVOYÉ' : 'ÉCHEC') }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-3 text-ink-muted">
                                        <div class="flex gap-2">
                                            <span class="px-1 py-0.5 rounded {{ t.spf_passed is same as(true) ? 'bg-signal/10 text-signal-dark' : 'bg-paper-dim text-ink-muted' }}">SPF</span>
                                            <span class="px-1 py-0.5 rounded {{ t.dkim_passed is same as(true) ? 'bg-signal/10 text-signal-dark' : 'bg-paper-dim text-ink-muted' }}">DKIM</span>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>

        <!-- Alert Configuration Column -->
        <div class="space-y-6">
            <!-- Alert Rules List -->
            <div class="bg-white border border-line p-6">
                <h3 class="font-mono text-sm font-bold text-ink mb-4">Canaux de notification</h3>
                {% if rules is empty %}
                    <p class="text-xs text-ink-muted">Aucune règle d'alerte configurée pour ce moniteur. Vous ne serez pas averti en cas de panne !</p>
                {% else %}
                    <ul class="space-y-3">
                        {% for r in rules %}
                            <li class="text-xs bg-paper-dim p-3 rounded border border-line flex justify-between items-center">
                                <div>
                                    <span class="font-mono font-semibold uppercase text-signal">{{ r.channel }}</span> vers
                                    <span class="text-ink-muted truncate block max-w-[150px] font-mono">{{ r.recipient }}</span>
                                    <span class="text-[10px] text-ink-muted block">Déclencheur : {{ r.conditionType }} (seuil : {{ r.threshold }})</span>
                                </div>
                                <span class="text-[10px] text-ink-muted shrink-0">Pause : {{ r.cooldownMinutes }}m</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <!-- Add Alert Rule Form -->
                <div class="mt-6 border-t border-line pt-6">
                    <h4 class="text-xs font-body font-bold text-ink uppercase tracking-wide mb-3">Ajouter un canal de notification</h4>
                    <form method="POST" action="{{ path('workspace_rule_new', {workspacePublicId: workspace.publicId, monitorPublicId: monitor.publicId}) }}" class="space-y-4">
                        <div>
                            <label for="channel" class="block text-[10px] font-semibold uppercase text-ink-muted">Canal</label>
                            <select name="channel" id="channel" class="mt-1 block w-full rounded-sm border-line text-xs p-1.5 border focus:border-signal focus:ring-signal">
                                <option value="email">Email</option>
                                <option value="slack">Webhook Slack</option>
                                <option value="telegram">Bot Telegram (token:chatId)</option>
                            </select>
                        </div>

                        <div>
                            <label for="recipient" class="block text-[10px] font-semibold uppercase text-ink-muted">Destinataire / Endpoint</label>
                            <input type="text" name="recipient" id="recipient" required placeholder="email@address.com ou url du webhook"
                                   class="mt-1 block w-full rounded-sm border-line text-xs p-1.5 border focus:border-signal focus:ring-signal">
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label for="condition_type" class="block text-[10px] font-semibold uppercase text-ink-muted">Condition</label>
                                <select name="condition_type" id="condition_type" class="mt-1 block w-full rounded-sm border-line text-xs p-1.5 border focus:border-signal focus:ring-signal">
                                    <option value="down_count">Nombre d'échecs</option>
                                    <option value="latency_threshold">Seuil de latence</option>
                                </select>
                            </div>
                            <div>
                                <label for="threshold" class="block text-[10px] font-semibold uppercase text-ink-muted">Seuil</label>
                                <input type="number" name="threshold" id="threshold" value="1" required
                                       class="mt-1 block w-full rounded-sm border-line text-xs p-1.5 border focus:border-signal focus:ring-signal">
                            </div>
                        </div>

                        <div>
                            <label for="cooldown_minutes" class="block text-[10px] font-semibold uppercase text-ink-muted">Pause (minutes)</label>
                            <input type="number" name="cooldown_minutes" id="cooldown_minutes" value="60" required
                                   class="mt-1 block w-full rounded-sm border-line text-xs p-1.5 border focus:border-signal focus:ring-signal">
                        </div>

                        <button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-xs font-body font-semibold rounded-sm text-paper bg-signal hover:bg-signal-dark">
                            Ajouter le canal
                        </button>
                    </form>
                </div>
            </div>

            <!-- Incident History Card -->
            <div class="bg-white border border-line p-6">
                <h3 class="font-mono text-sm font-bold text-ink mb-4">Journal des incidents</h3>
                <div data-monitor-live-target="incidents">
                {% if incidents is empty %}
                    <p class="text-xs text-ink-muted">Aucun événement d'alerte récent enregistré.</p>
                {% else %}
                    <ul class="space-y-3">
                        {% for inc in incidents %}
                            <li class="text-[10px] bg-paper-dim p-2 rounded border border-line">
                                <div class="flex justify-between items-center mb-1">
                                    <span class="font-mono font-bold text-alert">INCIDENT #{{ inc.id }}</span>
                                    <span class="font-semibold text-ink-muted">Déclencheur : {{ inc.condition_type }}</span>
                                </div>
                                <div class="text-ink-muted mb-1">
                                    Déclenché à {{ inc.triggered_at }}
                                </div>
                                <div class="flex justify-between items-center text-[9px] text-ink-muted">
                                    <span>Notifié : {{ inc.notified ? 'Oui' : 'Non' }}</span>
                                    <span class="font-mono {{ inc.status == 'resolved' ? 'text-signal-dark font-bold' : 'text-ink-muted font-bold' }}">
                                        {{ inc.status == 'resolved' ? 'RÉSOLU' : 'DÉCLENCHÉ' }} {% if inc.resolved_at %}(à {{ inc.resolved_at }}){% endif %}
                                    </span>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
