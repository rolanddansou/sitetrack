{% extends 'base.html.twig' %}

{% block title %}{{ monitor.name }} Details - SiteTrack{% endblock %}

{% block body %}
<div class="px-4 sm:px-0">
    <div class="mb-6 flex justify-between items-start">
        <div>
            <a href="{{ path('availability_index') }}" class="text-xs text-indigo-600 hover:text-indigo-900 flex items-center gap-1 mb-2">
                &larr; Back to Dashboard
            </a>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 flex items-center gap-2">
                <span>{{ monitor.type == 'http' ? '🌐' : '📧' }}</span>
                <span>{{ monitor.name }}</span>
            </h1>
            <p class="text-sm text-slate-500 mt-1">Check interval: every {{ monitor.interval }} minutes.</p>
        </div>
        <form method="POST" action="{{ path('monitor_delete', {publicId: monitor.publicId}) }}" onsubmit="return confirm('Are you sure you want to delete this monitor? This will also remove all logs.')">
            <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-red-300 text-xs font-semibold rounded text-red-700 bg-white hover:bg-red-50 focus:outline-none">
                Delete Monitor
            </button>
        </form>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <!-- Main Stats & Chart Column -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Current Status Card -->
            <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6">
                <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">Current Status</h3>
                <div class="flex items-center space-x-3">
                    {% if monitor.type == 'http' %}
                        {% set lastCheck = recentChecks|first %}
                        {% if lastCheck is empty %}
                            <span class="h-4 w-4 bg-slate-400 rounded-full animate-pulse"></span>
                            <span class="text-lg font-bold text-slate-500">No pings recorded yet</span>
                        {% elseif lastCheck.status == 'up' %}
                            <span class="h-4 w-4 bg-green-500 rounded-full"></span>
                            <span class="text-lg font-bold text-green-700">Online</span>
                            <span class="text-slate-400 text-xs">(Checked at {{ lastCheck.checkedAt|date('H:i:s') }})</span>
                        {% else %}
                            <span class="h-4 w-4 bg-red-500 rounded-full animate-ping"></span>
                            <span class="text-lg font-bold text-red-700">Offline</span>
                            <span class="text-xs text-red-500 bg-red-50 px-2 py-0.5 rounded ml-2">{{ lastCheck.errorMessage }}</span>
                        {% endif %}
                    {% else %}
                        {% set lastSmtp = smtpTests|first %}
                        {% if lastSmtp is empty %}
                            <span class="h-4 w-4 bg-slate-400 rounded-full animate-pulse"></span>
                            <span class="text-lg font-bold text-slate-500">No test mail sent yet</span>
                        {% elseif lastSmtp.status == 'delivered' %}
                            <span class="h-4 w-4 bg-green-500 rounded-full"></span>
                            <span class="text-lg font-bold text-green-700">Operational</span>
                            <span class="text-slate-400 text-xs">(Delivered in {{ lastSmtp.delivery_time_seconds }}s at {{ lastSmtp.received_at|date('H:i:s') }})</span>
                        {% elseif lastSmtp.status == 'sent' %}
                            <span class="h-4 w-4 bg-amber-500 rounded-full animate-pulse"></span>
                            <span class="text-lg font-bold text-amber-700">Awaiting Delivery Receipt...</span>
                        {% else %}
                            <span class="h-4 w-4 bg-red-500 rounded-full"></span>
                            <span class="text-lg font-bold text-red-700">Failed / Timed Out</span>
                            <span class="text-xs text-red-500 bg-red-50 px-2 py-0.5 rounded ml-2">{{ lastSmtp.error_message }}</span>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

            <!-- Performance / History Chart -->
            <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6">
                <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">
                    {{ monitor.type == 'http' ? 'Response Latency (ms)' : 'Delivery Time (seconds)' }}
                </h3>
                
                {% if monitor.type == 'http' and recentChecks is not empty %}
                    {% set maxVal = 1 %}
                    {% for c in recentChecks %}
                        {% if c.responseTimeMs > maxVal %}{% set maxVal = c.responseTimeMs %}{% endif %}
                    {% endfor %}
                    <div class="flex items-end gap-1 h-32 pt-4 border-b border-slate-200">
                        {% for c in recentChecks|slice(0, 30)|reverse %}
                            <div class="{{ c.status == 'up' ? 'bg-indigo-500' : 'bg-red-400' }} rounded-t flex-1" 
                                 style="height: {{ (c.responseTimeMs / maxVal * 100)|round }}%;" 
                                 title="{{ c.responseTimeMs }}ms at {{ c.checkedAt|date('H:i:s') }}">
                            </div>
                        {% endfor %}
                    </div>
                    <div class="flex justify-between text-xs text-slate-400 mt-2">
                        <span>Older</span>
                        <span>Latest</span>
                    </div>
                {% elseif monitor.type == 'smtp' and smtpTests is not empty %}
                    {% set maxVal = 1 %}
                    {% for t in smtpTests %}
                        {% if t.delivery_time_seconds > maxVal %}{% set maxVal = t.delivery_time_seconds %}{% endif %}
                    {% endfor %}
                    <div class="flex items-end gap-1 h-32 pt-4 border-b border-slate-200">
                        {% for t in smtpTests|slice(0, 30)|reverse %}
                            {% set pct = t.delivery_time_seconds ? (t.delivery_time_seconds / maxVal * 100)|round : 0 %}
                            <div class="{{ t.status == 'delivered' ? 'bg-teal-500' : (t.status == 'sent' ? 'bg-amber-400 animate-pulse' : 'bg-red-400') }} rounded-t flex-1" 
                                 style="height: {{ pct > 0 ? pct : 5 }}%;" 
                                 title="{% if t.status == 'delivered' %}{{ t.delivery_time_seconds }}s{% else %}{{ t.status }}{% endif %} at {{ t.sent_at }}">
                            </div>
                        {% endfor %}
                    </div>
                    <div class="flex justify-between text-xs text-slate-400 mt-2">
                        <span>Older</span>
                        <span>Latest</span>
                    </div>
                {% else %}
                    <p class="text-sm text-slate-400 text-center py-6">Insufficient check data to render metrics.</p>
                {% endif %}
            </div>

            <!-- Historical Log Table -->
            <div class="bg-white shadow-sm rounded-lg border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
                    <h3 class="text-sm font-bold text-slate-800">Check History Logs</h3>
                </div>
                {% if monitor.type == 'http' %}
                    <table class="min-w-full divide-y divide-slate-200 text-xs">
                        <thead>
                            <tr class="bg-slate-50 text-slate-500 text-left uppercase">
                                <th class="px-6 py-3 font-semibold">Checked At</th>
                                <th class="px-6 py-3 font-semibold">Status</th>
                                <th class="px-6 py-3 font-semibold">Latency</th>
                                <th class="px-6 py-3 font-semibold">Details</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 bg-white">
                            {% for c in recentChecks %}
                                <tr>
                                    <td class="px-6 py-3 text-slate-500">{{ c.checkedAt|date('Y-m-d H:i:s') }}</td>
                                    <td class="px-6 py-3">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold {{ c.status == 'up' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' }}">
                                            {{ c.status|upper }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-3 text-slate-900">{{ c.responseTimeMs }} ms</td>
                                    <td class="px-6 py-3 text-slate-400 truncate max-w-xs">{{ c.errorMessage ?: '--' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <table class="min-w-full divide-y divide-slate-200 text-xs">
                        <thead>
                            <tr class="bg-slate-50 text-slate-500 text-left uppercase">
                                <th class="px-6 py-3 font-semibold">Sent At</th>
                                <th class="px-6 py-3 font-semibold">Received At</th>
                                <th class="px-6 py-3 font-semibold">Delivery Time</th>
                                <th class="px-6 py-3 font-semibold">Status</th>
                                <th class="px-6 py-3 font-semibold">Headers</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 bg-white">
                            {% for t in smtpTests %}
                                <tr>
                                    <td class="px-6 py-3 text-slate-500">{{ t.sent_at }}</td>
                                    <td class="px-6 py-3 text-slate-500">{{ t.received_at ?: '--' }}</td>
                                    <td class="px-6 py-3 text-slate-900">{{ t.delivery_time_seconds ? t.delivery_time_seconds ~ ' s' : '--' }}</td>
                                    <td class="px-6 py-3">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold {{ t.status == 'delivered' ? 'bg-green-50 text-green-700' : (t.status == 'sent' ? 'bg-amber-50 text-amber-700' : 'bg-red-50 text-red-700') }}">
                                            {{ t.status|upper }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-3 text-slate-400">
                                        <div class="flex gap-2">
                                            <span class="px-1 py-0.5 rounded {{ t.spf_passed is same as(true) ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-400' }}">SPF</span>
                                            <span class="px-1 py-0.5 rounded {{ t.dkim_passed is same as(true) ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-400' }}">DKIM</span>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>

        <!-- Alert Configuration Column -->
        <div class="space-y-6">
            <!-- Alert Rules List -->
            <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6">
                <h3 class="text-sm font-bold text-slate-800 mb-4">Notification Channels</h3>
                {% if rules is empty %}
                    <p class="text-xs text-slate-400">No alert rules configured for this monitor. You won't be notified of failures!</p>
                {% else %}
                    <ul class="space-y-3">
                        {% for r in rules %}
                            <li class="text-xs bg-slate-50 p-3 rounded border border-slate-200 flex justify-between items-center">
                                <div>
                                    <span class="font-semibold uppercase text-indigo-600">{{ r.channel }}</span> to
                                    <span class="text-slate-600 truncate block max-w-[150px] font-mono">{{ r.recipient }}</span>
                                    <span class="text-[10px] text-slate-400 block">Trigger: {{ r.conditionType }} (thresh: {{ r.threshold }})</span>
                                </div>
                                <span class="text-[10px] text-slate-400 shrink-0">Cool: {{ r.cooldownMinutes }}m</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <!-- Add Alert Rule Form -->
                <div class="mt-6 border-t border-slate-200 pt-6">
                    <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wide mb-3">Add Channel Notification</h4>
                    <form method="POST" action="{{ path('rule_new', {publicId: monitor.publicId}) }}" class="space-y-4">
                        <div>
                            <label for="channel" class="block text-[10px] font-semibold uppercase text-slate-500">Channel</label>
                            <select name="channel" id="channel" class="mt-1 block w-full rounded border-slate-300 text-xs p-1.5 border">
                                <option value="email">Email</option>
                                <option value="slack">Slack Webhook</option>
                                <option value="telegram">Telegram Bot (token:chatId)</option>
                            </select>
                        </div>

                        <div>
                            <label for="recipient" class="block text-[10px] font-semibold uppercase text-slate-500">Recipient / Endpoint</label>
                            <input type="text" name="recipient" id="recipient" required placeholder="email@address.com or webhook url"
                                   class="mt-1 block w-full rounded border-slate-300 text-xs p-1.5 border">
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label for="condition_type" class="block text-[10px] font-semibold uppercase text-slate-500">Condition</label>
                                <select name="condition_type" id="condition_type" class="mt-1 block w-full rounded border-slate-300 text-xs p-1.5 border">
                                    <option value="down_count">Failure Count</option>
                                    <option value="latency_threshold">Latency limit</option>
                                </select>
                            </div>
                            <div>
                                <label for="threshold" class="block text-[10px] font-semibold uppercase text-slate-500">Threshold</label>
                                <input type="number" name="threshold" id="threshold" value="1" required
                                       class="mt-1 block w-full rounded border-slate-300 text-xs p-1.5 border">
                            </div>
                        </div>

                        <div>
                            <label for="cooldown_minutes" class="block text-[10px] font-semibold uppercase text-slate-500">Cooldown (Minutes)</label>
                            <input type="number" name="cooldown_minutes" id="cooldown_minutes" value="60" required
                                   class="mt-1 block w-full rounded border-slate-300 text-xs p-1.5 border">
                        </div>

                        <button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-xs font-semibold rounded text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm">
                            Add Channel
                        </button>
                    </form>
                </div>
            </div>

            <!-- Incident History Card -->
            <div class="bg-white shadow-sm rounded-lg border border-slate-200 p-6">
                <h3 class="text-sm font-bold text-slate-800 mb-4">Incident Log</h3>
                {% if incidents is empty %}
                    <p class="text-xs text-slate-400">No recent alert events logged.</p>
                {% else %}
                    <ul class="space-y-3">
                        {% for inc in incidents %}
                            <li class="text-[10px] bg-slate-50 p-2 rounded border border-slate-200">
                                <div class="flex justify-between items-center mb-1">
                                    <span class="font-bold text-red-600">INCIDENT #{{ inc.id }}</span>
                                    <span class="font-semibold text-slate-400">Trigger: {{ inc.condition_type }}</span>
                                </div>
                                <div class="text-slate-600 mb-1">
                                    Triggered at {{ inc.triggered_at }}
                                </div>
                                <div class="flex justify-between items-center text-[9px] text-slate-400">
                                    <span>Notified: {{ inc.notified ? 'Yes' : 'No' }}</span>
                                    <span class="{{ inc.status == 'resolved' ? 'text-green-600 font-bold' : 'text-amber-600 font-bold' }}">
                                        {{ inc.status|upper }} {% if inc.resolved_at %}(at {{ inc.resolved_at }}){% endif %}
                                    </span>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
