<header class="border-b border-slate-200 shrink-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <a href="{{ path('homepage') }}" class="text-xl font-black text-indigo-600 tracking-tight flex items-center">
                📡 SiteTrack
            </a>

            {% if app.user %}
                <a href="{{ path('dashboard_index') }}"
                   class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-semibold rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700">
                    Go to dashboard
                </a>
            {% else %}
                <div class="flex items-center gap-4">
                    <a href="{{ path('app_login') }}" class="text-sm font-medium text-slate-600 hover:text-slate-900">Log in</a>
                    <a href="{{ path('app_login') }}"
                       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-semibold rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700">
                        Get started
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</header>
