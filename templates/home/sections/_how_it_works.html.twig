<section id="how-it-works" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {% import 'components/_macros.html.twig' as m %}
        {{ m.section_heading('How it works', 'Set up once, get out of the way') }}

        <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-10 sm:divide-x sm:divide-line">
            <div class="text-center sm:px-6">
                <p class="font-mono text-sm text-signal">[01]</p>
                <h3 class="mt-3 text-base font-body font-semibold text-ink">Add your site</h3>
                <p class="mt-2 text-sm font-body text-ink-muted">Point SiteTrack at your URL (and your SMTP server, if you want deliverability checks too).</p>
            </div>
            <div class="text-center sm:px-6">
                <p class="font-mono text-sm text-signal">[02]</p>
                <h3 class="mt-3 text-base font-body font-semibold text-ink">Configure alerts</h3>
                <p class="mt-2 text-sm font-body text-ink-muted">Pick a channel — email, Slack, or Telegram — and a threshold. We handle cooldowns automatically.</p>
            </div>
            <div class="text-center sm:px-6">
                <p class="font-mono text-sm text-signal">[03]</p>
                <h3 class="mt-3 text-base font-body font-semibold text-ink">Get notified, not surprised</h3>
                <p class="mt-2 text-sm font-body text-ink-muted">We check on your schedule and tell you the moment something breaks — before your customers do.</p>
            </div>
        </div>
    </div>
</section>
