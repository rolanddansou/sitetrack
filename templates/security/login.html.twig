{% extends 'base.html.twig' %}

{% block title %}Log in - SiteTrack{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto mt-12 px-4 sm:px-0">
        <div class="bg-white border border-line p-8">
            <h1 class="text-xl font-display font-bold text-ink mb-1">Log in</h1>
            <p class="text-sm text-ink-muted mb-6">Accédez à votre tableau de bord SiteTrack.</p>

            {% if error %}
                <div class="mb-6 p-4 border border-alert/30 bg-alert/5 text-alert text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="space-y-4">
                <div>
                    <label for="username" class="block text-sm font-body font-semibold text-ink">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" required autofocus
                           class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                </div>

                <div>
                    <label for="password" class="block text-sm font-body font-semibold text-ink">Password</label>
                    <input type="password" name="_password" id="password" required
                           class="mt-1 block w-full rounded-sm border-line focus:border-signal focus:ring-signal sm:text-sm p-2 border">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-body font-semibold rounded-sm text-paper bg-signal hover:bg-signal-dark">
                    Log in
                </button>
            </form>
        </div>
    </div>
{% endblock %}
